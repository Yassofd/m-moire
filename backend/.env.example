PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT — CHANGER EN PRODUCTION
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Email SMTP — optionnel en dev (les codes OTP sont loggés en console si vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@chainbackup.io

# Twilio SMS — optionnel en dev (les codes OTP sont loggés en console si vide)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
